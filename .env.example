# Copy to .env.local (local) or add in Vercel > Settings > Environment Variables. Never commit real keys.
NEXT_PUBLIC_SITE_URL=https://drsharmisthabhattacharyya.com

# Session signing. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Online consultation fee in INR (PLACEHOLDER: confirm the real amount with the doctor)
CONSULTATION_FEE_INR=1500

# --- Supabase (database + staff login) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # secret, server only

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=              # the secret you type when creating the webhook

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=                       # permanent system-user token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_LANG=en                      # must match the language you chose in Meta (e.g. en or en_US)
WHATSAPP_WABA_ID=                     # optional: WhatsApp Business Account ID to show live template approval status in Staff Portal
WHATSAPP_ALLOW_TEXT_FALLBACK=true     # set false to prevent falling back to 24h-only text when a Meta template rejects
# Optional template name overrides (if your approved Meta template names differ from docs/whatsapp-templates.md):
WHATSAPP_TEMPLATE_BOOKING_CONFIRMATION=
WHATSAPP_TEMPLATE_PAYMENT_RECEIPT=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_RESCHEDULED=
WHATSAPP_TEMPLATE_CANCELLED=
WHATSAPP_TEMPLATE_PRESCRIPTION_READY=
WHATSAPP_TEMPLATE_REPORT_READY=
WHATSAPP_TEMPLATE_FOLLOWUP=

# --- Brevo (email) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=                   # a sender you verified in Brevo
CLINIC_NOTIFY_EMAIL=                  # clinic inbox for new bookings, enquiries and problems

# --- Google Calendar + Meet (run scripts/google-auth.mjs once to get the refresh token) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Cloudflare R2 (private bucket for prescriptions, reports, receipts) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Reminders: any scheduler calls /api/cron/reminders every 15 minutes with "Authorization: Bearer <CRON_SECRET>" ---
CRON_SECRET=

# Demo sign-in works only when Supabase is NOT configured, in development. Never enable on a live site.
ALLOW_DEMO_AUTH=false
STAFF_DEMO_PASSWORD=Demo@12345
